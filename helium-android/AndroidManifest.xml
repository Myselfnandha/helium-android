<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.imput.helium">

    <!-- Permissions required for web browsing and background synchronization -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/helium_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Primary Browser Window (App Launcher & Default Browser Entry) -->
        <activity
            android:name="net.imput.helium.browser.HeliumMainActivity"
            android:exported="true"
            android:label="@string/helium_app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Web Browsing Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- First-Run Setup Wizard Activity -->
        <activity
            android:name="net.imput.helium.onboarding.HeliumFirstRunActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <!-- Extension Manager Activity -->
        <activity
            android:name="net.imput.helium.extensions.HeliumExtensionsActivity"
            android:exported="true"
            android:label="@string/extensions_title"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- Progressive Web Application Standalone Window (PRD M25) -->
        <activity
            android:name="net.imput.helium.browser.shortcut.PwaActivity"
            android:exported="true"
            android:label="@string/helium_app_name"
            android:launchMode="singleTop"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Background Vault Synchronization Service -->
        <service
            android:name="net.imput.helium.sync.VaultSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Home-Screen Search Widget Provider -->
        <receiver
            android:name="net.imput.helium.widget.SearchWidgetProvider"
            android:exported="true"
            android:label="@string/search_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/helium_search_widget_info" />
        </receiver>

        <!-- Search Widget Configuration Activity -->
        <activity
            android:name="net.imput.helium.widget.SearchWidgetConfigureActivity"
            android:exported="true"
            android:label="@string/widget_configure_title"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Quick Search Translucent Typing Overlay & Floating Mini-Browser -->
        <activity
            android:name="net.imput.helium.widget.QuickSearchOverlayActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Helium.Translucent"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="stateVisible|adjustResize" />

    </application>

</manifest>
