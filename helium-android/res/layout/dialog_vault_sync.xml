<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/helium_surface"
    android:padding="20dp">

    <!-- Header: Vault Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_sync_vault"
            android:contentDescription="Private Vault" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helium Private Vault"
                android:textColor="@color/helium_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zero-Knowledge AES-256-GCM E2EE Sync"
                android:textColor="@color/helium_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab Bar: Export vs Import Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_rounded">

        <Button
            android:id="@+id/btn_mode_export"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Export Vault"
            android:textColor="@color/helium_accent_cyan"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mode_import"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Import Vault"
            android:textColor="@color/helium_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/helium_border" />

    <!-- Container 1: Export View -->
    <LinearLayout
        android:id="@+id/ll_export_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Package bookmarks and history into an encrypted bundle for pairing with desktop Helium."
            android:textColor="@color/helium_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_export_passphrase"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Set Encryption Passphrase"
            android:inputType="textPassword"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="12dp"
            android:textColor="@color/helium_text_primary"
            android:textColorHint="@color/helium_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_generate_vault"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Encrypt &amp; Generate Vault Bundle"
            android:textColor="@color/helium_accent_cyan"
            android:background="@drawable/bg_card_rounded" />

        <LinearLayout
            android:id="@+id/ll_export_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_export_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vault Bundle Ready"
                android:textColor="@color/helium_shield_active"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tv_vault_payload"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_rounded"
                android:padding="8dp"
                android:textSize="11sp"
                android:textColor="@color/helium_text_primary"
                android:editable="false"
                android:fontFamily="monospace"
                android:gravity="top|start" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_copy_vault"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Copy Payload"
                    android:textColor="@color/helium_accent_cyan" />

                <Button
                    android:id="@+id/btn_share_vault"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Share Bundle"
                    android:textColor="@color/helium_accent_cyan" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Container 2: Import View -->
    <LinearLayout
        android:id="@+id/ll_import_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste an encrypted vault payload (from desktop Helium or another device) to merge into your browser."
            android:textColor="@color/helium_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_import_payload"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Paste helium-vault:v1:... payload here"
            android:background="@drawable/bg_card_rounded"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="@color/helium_text_primary"
            android:textColorHint="@color/helium_text_secondary"
            android:gravity="top|start"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/et_import_passphrase"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Decryption Passphrase"
            android:inputType="textPassword"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="12dp"
            android:textColor="@color/helium_text_primary"
            android:textColorHint="@color/helium_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_import_vault"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Decrypt &amp; Merge into Browser"
            android:textColor="@color/helium_accent_cyan"
            android:background="@drawable/bg_card_rounded" />

        <TextView
            android:id="@+id/tv_import_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
