<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/helium_surface"
    android:padding="20dp">

    <!-- Header: Shield status & Domain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_shield_status"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="Shield Status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_shield_domain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="example.com"
                android:textColor="@color/helium_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_shield_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helium Privacy Shields Active"
                android:textColor="@color/helium_shield_active"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/helium_border" />

    <!-- Feature 1: Subresource Blocked Metrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trackers &amp; Ads Blocked"
            android:textColor="@color/helium_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_blocked_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/helium_accent_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Feature 2: Anti-Fingerprinting Noise -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Anti-Fingerprinting Noise"
            android:textColor="@color/helium_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_noise_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active (Canvas/WebGL)"
            android:textColor="@color/helium_shield_active"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Feature 3: Connection Encryption -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Transport Security"
            android:textColor="@color/helium_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_https_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTPS Secure (TLS)"
            android:textColor="@color/helium_shield_active"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Feature 4: Vanadium JIT Protection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vanadium JIT Hardening"
            android:textColor="@color/helium_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_jit_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protected"
            android:textColor="@color/helium_shield_active"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/helium_border" />

    <!-- Action Button: Open Helium Settings -->
    <Button
        android:id="@+id/btn_open_shield_settings"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure Privacy Settings"
        android:textColor="@color/helium_accent_cyan" />

</LinearLayout>
