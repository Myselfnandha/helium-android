<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/bg_widget_search">

    <ImageView
        android:id="@+id/widget_btn_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_helium_logo"
        android:contentDescription="@string/helium_app_name" />

    <TextView
        android:id="@+id/widget_search_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/search_widget_hint"
        android:textColor="@color/helium_text_secondary"
        android:textSize="14sp"
        android:singleLine="true" />

    <LinearLayout
        android:id="@+id/widget_shortcuts_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_btn_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/widget_voice_shortcut" />

        <ImageView
            android:id="@+id/widget_btn_bookmarks"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark"
            android:contentDescription="@string/widget_bookmarks_shortcut" />

        <ImageView
            android:id="@+id/widget_btn_qr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:visibility="gone"
            android:src="@drawable/ic_qr_code"
            android:contentDescription="@string/widget_qr_shortcut" />

    </LinearLayout>

</LinearLayout>
