<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_tab_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_helium_logo"
        android:contentDescription="Tab Favicon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_tab_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New Tab"
                android:textColor="@color/helium_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/iv_pin_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                android:contentDescription="Pinned Tab" />

            <TextView
                android:id="@+id/tv_tab_group_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Work"
                android:textColor="@color/helium_accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card_rounded"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_tab_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="about:blank"
            android:textColor="@color/helium_text_secondary"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_close_tab"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:src="@drawable/ic_refresh"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Tab" />

</LinearLayout>
